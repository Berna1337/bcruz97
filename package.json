{
  "name": "astro-blog-starter-template",
  "description": "Build a personal website, blog, or portfolio with Astro.",
  "cloudflare": {
    "label": "Astro Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
    "publish": true
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.1",
    "astro": "7.4.12",
    "typescript": "5.9.3",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "node scripts/build.mjs",
    "cf-typegen": "wrangler types",
    "check": "npm test && npm run build && tsc && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "dev": "node scripts/media.mjs && astro dev",
    "preview": "npm run build && wrangler dev --infer-origin-from-routes=false",
    "build:preview": "node scripts/build.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "deploy:preview": "npm run build:preview && wrangler deploy --config wrangler.preview.json",
    "preview:site": "npm run build:preview && wrangler dev --config wrangler.preview.json --infer-origin-from-routes=false"
  },
  "type": "module"
}
