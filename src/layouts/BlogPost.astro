---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props = CollectionEntry<'blog'>['data'] & { preview?: boolean };
const {title, description, pubDate, updatedDate, readingTime, heroImage, heroImageAlt, audioFile, preview = false} = Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={`${title} — bcruz97`} description={description} image={heroImage || undefined} noindex={preview} /></head><body><Header /><main id="main" class="article-wrap"><a class="text-link mono" href={preview ? "/preview/" : "/blog/"}>{preview ? "← Back to drafts" : "← Back to the blog"}</a><article>{preview && <div class="preview-notice">Private preview · This page is only available after signing in.</div>}<div class="article-meta mono"><FormattedDate date={pubDate} /><span>·</span><span>{readingTime} min read</span></div><h1>{title}</h1><p class="article-description">{description}</p>{heroImage && <figure class="article-hero"><img src={heroImage} alt={heroImageAlt || ''} /></figure>}{audioFile && <section class="article-audio" aria-label="Post audio"><p>Listen</p><audio controls preload="none" src={audioFile}>Your browser cannot play this audio.</audio><a href={audioFile}>Download audio</a></section>}<div class="prose"><slot /></div>{updatedDate && <p class="mono muted">Updated <FormattedDate date={updatedDate} /></p>}<div class="article-signature"><img src="/logo.png" width="48" height="48" alt="" /><div><strong>Bernardo Cruz</strong><span class="mono">bcruz97</span></div></div><a class="text-link" href={preview ? "/preview/" : "/blog/"}>{preview ? "Back to drafts" : "All posts"} <span aria-hidden="true">→</span></a></article></main><Footer /></body></html>
