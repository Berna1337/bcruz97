---
import type { CollectionEntry } from 'astro:content';
import { readingMinutes } from '../lib/publishing.mjs';
import { imageAttributes } from '../lib/media';
import FormattedDate from './FormattedDate.astro';
interface Props { post: CollectionEntry<'blog'>; href?: string; }
const { post, href = `/blog/${Astro.props.post.id}/` } = Astro.props;
---
<a class:list={["post-entry", { "has-thumbnail": !!post.data.heroImage }]} href={href} data-post data-category={post.data.category?.toLowerCase() || ""} data-search={`${post.data.title} ${post.data.description} ${post.data.category || ""}`.toLowerCase()}>
  <div class="entry-date mono"><FormattedDate date={post.data.pubDate} />{post.data.category && <span>{post.data.category}</span>}</div>
  <div class="entry-copy">
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <span class="entry-details">{import.meta.env.PUBLIC_BLOG_PREVIEW === 'true' && <>{post.data.draft ? "Draft" : "Published"} · </>}{readingMinutes(post.body)} min read</span>
  </div>
{post.data.heroImage && <img class="entry-thumbnail" {...imageAttributes(post.data.heroImage, true)} alt="" loading="lazy" />}
</a>
