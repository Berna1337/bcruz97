---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main" class="wrap notebook-layout">
      <aside class="margin-notes">
        <p class="margin-name">Bernardo Cruz</p>
        <p class="mono muted">also known as bcruz97</p>
        <p class="margin-bio"><a class="underlined" href="/about/">About me</a></p>
        <p class="margin-footnote"><a class="underlined" href="/rss.xml">Subscribe via RSS</a></p>
      </aside>
      <div class="notebook-content">
        <section class="home-intro">
          <h1>Welcome.</h1>
          <p>This is my personal blog. I write about whatever’s on my mind.</p>
        </section>
        <section aria-labelledby="recent-writing">
          <div class="writing-heading"><h2 id="recent-writing">Recent writing</h2><a class="underlined" href="/blog/">All posts</a></div>
          <div class="entry-list">{posts.length > 0 ? posts.map(post => <PostCard post={post} />) : <p class="empty-state">No posts yet.</p>}</div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
