---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PREVIEW_COOKIE, PREVIEW_SESSION_SECONDS, createPreviewSession, passwordMatches, readPreviewPassword } from '../../lib/preview-auth';
export const prerender = false;
let error = '';
if (Astro.request.method === 'POST') {
  const submitted = await readPreviewPassword(Astro.request);
  const password = Astro.locals.runtime.env.PREVIEW_PASSWORD!;
  if (typeof submitted === 'string' && await passwordMatches(submitted, password)) {
    Astro.cookies.set(PREVIEW_COOKIE, await createPreviewSession(password), {
      httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'strict',
      path: '/preview', maxAge: PREVIEW_SESSION_SECONDS,
    });
    return Astro.redirect('/preview/', 303);
  }
  error = 'That password didn’t match. Try again.';
  Astro.response.status = 401;
}
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Private preview — bcruz97" description="Sign in to preview your writing." noindex /></head>
  <body>
    <Header />
    <main id="main" class="article-wrap preview-login">
      <h1>Private preview</h1>
      <p>Sign in to read your drafts.</p>
      <form method="post" action="/preview/login/" class="preview-form">
        <label for="preview-password">Preview password</label>
        <input id="preview-password" name="password" type="password" autocomplete="current-password" required maxlength="1024" aria-invalid={error ? true : undefined} aria-describedby={error ? 'login-error' : undefined} />
        {error && <p id="login-error" role="alert">{error}</p>}
        <button type="submit">Sign in</button>
      </form>
    </main>
    <Footer />
  </body>
</html>
