---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
export const prerender = false;
const drafts = (await getCollection('blog', ({ data }) => data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Your drafts — bcruz97" description="Private draft previews." noindex /></head>
  <body>
    <Header />
    <main id="main" class="article-wrap">
      <div class="preview-toolbar"><span>Private preview</span><form method="post" action="/preview/logout/"><button type="submit">Sign out</button></form></div>
      <h1>Your drafts</h1>
      <p class="page-intro">Save in Pages CMS, then check it here after the site finishes updating.</p>
      <div class="entry-list preview-drafts">
        {drafts.map(post => <PostCard post={post} href={`/preview/${post.id}/`} />)}
        {drafts.length === 0 && <p class="empty-state">No drafts yet.</p>}
      </div>
    </main>
    <Footer />
  </body>
</html>
